- content_for :addjs_in_head
  = javascript_include_tag 'day_page', 'data-turbolinks-track': 'reload', defer: true
  = javascript_include_tag 'diaries_sidebar', 'data-turbolinks-track': 'reload', defer: true
#dayPage(data-target-date="#{@date}")
  toast(:showable="toastShowable" :is-error="toastError" :message="toastMessage" @toast-hidden="toastShowable = false")
  / モーダルで日記を表示するためのhtmlの仕込み
  modal(v-if="!!modalableDiaryId" :no-padding="true" @on-close="closeDiaryModal")
    template(v-slot:content)
      diary(
        :diary-id="modalableDiaryId"
                  :can-append-memo="true"
        :modal-mode="true"
        ref="modalDiary"
        @submitted="reflectPinnedDiaries"
        @append-memo="showMemoForm"
      )

  / 「日記にメモ」フォーム
  - append_memo_form = capture do
    #memo-form.memo-modal(v-if="memoFormOpen" :class="{ 'is-over-history': memoOverHistoryModal }" role="dialog" aria-modal="true" :aria-label="memoModalTitle" @keydown.esc="closeMemoForm")
      .memo-modal__backdrop(@click="closeMemoForm")
      form.memo-modal__dialog(ref="memoForm" @submit="submitAppendingMemo")
        header.memo-modal__header
          h5
            | 📝
            | {{ memoModalTitle }}
          button.memo-modal__close(type="button" aria-label="閉じる" @click="closeMemoForm") ×
        .memo-modal__body
          .memo-modal__fields
            label.memo-modal__field
              span.memo-modal__field-label
                clock-icon(:size="17" aria-hidden="true")
                | 時刻
              input(type="time" name="diary[time_memo]" v-model="memoTime")
            label.memo-modal__field
              span.memo-modal__field-label 分類
              select(name="diary[label_memo]" v-model="memoCategory")
                option(v-for="cate in memoCategories" :value="cate" v-text="cate")
          p.memo-modal__target(v-if="memoTargetDiaryLabel")
            sticky-note-icon.memo-inline-icon(:size="15" aria-hidden="true")
            | 追記先: {{ memoTargetDiaryLabel }}
          textarea.memo-modal__textarea.first-focus(name="diary[memo]" v-model="memoContent" ref="memoContentField" @input="saveMemoDraft")
          input(type="hidden" name="diary[record_at]" :value="memoTargetRecordAt || '#{@date}'")
          input(type="hidden" name="diary[diary_id]" :value="memoTargetDiaryId")
        footer.memo-modal__footer
          small
            circle-alert-icon.memo-inline-icon(:size="15" aria-hidden="true")
            | 選択した日記の本文末尾にメモを追加します
          button.memo-modal__submit(type="submit") メモ追加

  .dayContentHeader
    .nav-container
      = link_to day_path(@date - 1), class: 'nav-arrow prev-day', title: 'ショートカットキー: shift + <' do
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
          polyline points="15 18 9 12 15 6"
      day-date-picker(selected-date="#{@date}" display-date="#{dispdate(@date, true)}" day-path-template="#{day_path('__DATE__')}")
      = link_to day_path(@date + 1), class: 'nav-arrow next-day', title: 'ショートカットキー: shift + >' do
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
          polyline points="9 18 15 12 9 6"

    = append_memo_form
    .action-buttons
      = link_to root_path, class: 'action-button btn-today' do
        span.button-icon
          | 🏠
        | 今日
      = link_to month_path(month: @date.to_fs(:ym)), class: 'action-button btn-calendar' do
        span.button-icon
          | 📅
        | 月間


  .day-layout
    .sectionHabitRecords
      .page-header
        h4
          | 本日の記録
      p(v-if="habit_records.length == 0") 習慣が登録されていません。
      .habit-records(v-else)
        habit-record(v-for="habit_record in visibleHabitRecords" :habit="habit_record.habit" :record="habit_record.record" target-date="#{@date}" :key="habit_record.habit.id")
        button.day-secondary-button(type="button" v-if="hiddenHabitRecordsCount > 0" @click="showAllHabitRecords = true")
          | もっと見る（未記録 {{ hiddenHabitRecordsCount }}件）
        button.day-secondary-button(type="button" v-else-if="showAllHabitRecords && collapsibleHabitRecordsCount > 0" @click="showAllHabitRecords = false")
          | 閉じる

    / NOTE: .overflow-autoを付加すると、子要素の幅が限界を超えた時に、画面全体ではなく、この要素に対してスクロールバーが表示される
    / 付加しないと、画面全体にスクロールバーが表示される
    .sectionDiaries
      .page-header.day-section-header
        h4
          | 本日の日記&nbsp;
          / 「data-trigger="focus"」を与えることで、本buttonではなく、他の場所のクリック時に消えるようになる（逆に与えないと、他の場所クリックで消えないので不便だった）
          button.day-count-button(v-show="diariesWithOpsions.length > 1" data-toggle="popover" data-trigger="focus" title="日記リスト" :data-content="diary_links_list") {{ diariesWithOpsions.length }}
      .diaries(ref="diariesBody")
        p(v-if="diariesLoading") 読み込み中...
        template(v-else)
          p(v-if="diariesWithOpsions.length == 0") 日記はありません。
          .diaries-grid(v-else :class="{ 'two-columns': secondaryDiaryObjs.length > 0 }")
            .diary-main(v-if="mainDiaryObj")
              .diary-wrapper
                diary(
                  :diary="mainDiaryObj.diary"
                  :target-date-for-edit-mode="mainDiaryObj.targetDateForEditMode"
                  :highlight-for-a-moment="mainDiaryObj.highlightForAMoment"
                  :key="`diary-${mainDiaryObj.diary.id}`"
                  :categories="categories"
                  :collapsible-body="false"
                  :can-append-memo="true"
                  @content-changed="onContentChanged"
                  @submitted="onSubmitted"
                  @on-edit-mode="onEditMode"
                  @append-memo="showMemoForm"
                )
            .diary-list
              .diary-wrapper(v-for="obj in secondaryDiaryObjs")
                diary(
                  :diary="obj.diary"
                  :target-date-for-edit-mode="obj.targetDateForEditMode"
                  :highlight-for-a-moment="obj.highlightForAMoment"
                  :key="`diary-${obj.diary.id}`"
                  :categories="categories"
                  :collapsible-body="true"
                  :can-append-memo="true"
                  :collapse-by-default="shouldCollapseSecondaryDiary"
                  @content-changed="onContentChanged"
                  @submitted="onSubmitted"
                  @on-edit-mode="onEditMode"
                  @append-memo="showMemoForm"
                )
      .diary-create-actions(v-if="!diariesLoading")
        button.diary-create-button.btn-main-diary(type="button" v-if="!hasMainDiary" @click="newMainDiary")
          star-icon(:size="17" aria-hidden="true")
          | メイン日記を作成
        button.diary-create-button.btn-new-diary.ignore-checking-changes(type="button" @click="newDiary")
          pencil-icon(:size="17" aria-hidden="true")
          | 日記を書く

    .sectionPinnedDiaries
      / NOTE: turbolinks permanentで日付遷移時もDOMを保持し、サイドバーの再fetchを防ぐ
      #diariesSidebar[data-turbolinks-permanent]

sass:
  $habit-records-width: 370px
  $pinned-diaries-width: 400px
  $desktop-breakpoint: 992px
  $diary-two-columns-breakpoint: 2100px

  /* 2025/01/08 Claudeのデザイン */
  .dayContentHeader
    width: 450px;
    padding: 12px;
    box-sizing: border-box;
    margin: 7px auto 5px
    position: relative

    .nav-container
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 12px;

    .nav-arrow
      width: 50px;
      height: 50px;
      background: #ebf5ff;
      border: none;
      border-radius: 8px;
      color: #2563eb;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      cursor: pointer;
      transition: background-color 0.2s;

    .nav-arrow:hover
      background: #dbeafe;

    .nav-arrow svg
      width: 30px;
      height: 30px;
      stroke-width: 2.5;

    .action-buttons
      display: flex;
      justify-content: space-between;
      gap: 8px;

    .action-button
      flex: 1;
      height: 36px;
      border: none;
      border-radius: 8px;
      color: white;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background-color 0.2s;
    .action-button:hover
      color: white;
      text-decoration: none;

    .btn-today
      background: #16a34a;

    .btn-today:hover
      background: #15803d;

    .btn-memo
      background: #dc2626;

    .btn-memo:hover
      background: #b91c1c;

    .btn-calendar
      background: #06b6d4;

    .btn-calendar:hover
      background: #0891b2;

    .button-icon
      margin-right: 4px;

  @media (max-width: 640px)
    .dayContentHeader
      width: 100%
      padding: 8px;

      .action-buttons
        gap: 4px;
      .action-button
        font-size: 13px;

  .memo-modal
    position: fixed
    z-index: 20020
    inset: 0
    display: flex
    padding: 20px
    align-items: center
    justify-content: center

    &.is-over-history
      z-index: 21030

  .memo-modal__backdrop
    position: absolute
    inset: 0
    background: rgba(0, 0, 0, 0.55)

  .memo-modal__dialog
    position: relative
    width: 100%
    max-width: 520px
    max-height: calc(100vh - 40px)
    overflow-y: auto
    border-radius: 10px
    background: #fff
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25)

  .memo-modal__header,
  .memo-modal__footer
    display: flex
    padding: 14px 18px
    align-items: center
    justify-content: space-between
    gap: 12px

  .memo-modal__header
    border-bottom: 1px solid #e5e7eb
    h5
      margin: 0
      font-size: 18px

  .memo-modal__body
    padding: 18px

  .memo-modal__close
    border: 0
    background: transparent
    color: #6b7280
    cursor: pointer
    font-size: 28px
    line-height: 1

  .memo-modal__fields
    display: grid
    grid-template-columns: 1fr 1fr
    gap: 12px
    margin-bottom: 12px

  .memo-modal__field
    display: flex
    flex-direction: column
    gap: 5px
    margin: 0
    input,
    select
      width: 100%
      padding: 8px 10px
      border: 1px solid #d1d5db
      border-radius: 6px
      background: #fff

  .memo-modal__field-label
    display: inline-flex
    align-items: center
    gap: 5px
    color: #4b5563
    font-size: 13px
    font-weight: 600

  .memo-modal__target
    margin: 0 0 10px
    color: #6b7280
    font-size: 14px

  .memo-modal__textarea
    display: block
    width: 100%
    min-height: 140px
    padding: 10px 12px
    border: 1px solid #d1d5db
    border-radius: 6px
    resize: vertical

  .memo-modal__footer
    border-top: 1px solid #e5e7eb
    small
      color: #6b7280

  .memo-modal__submit
    flex-shrink: 0
    padding: 8px 16px
    border: 1px solid #2563eb
    border-radius: 6px
    background: #2563eb
    color: #fff
    cursor: pointer
    font-weight: 600

    &:hover
      background: #1d4ed8

  .memo-inline-icon
    display: inline-block
    margin-right: 4px
    vertical-align: -2px

  @media (max-width: 640px)
    .memo-modal
      padding: 10px
    .memo-modal__fields
      grid-template-columns: 1fr
    .memo-modal__footer
      align-items: stretch
      flex-direction: column
    .memo-modal__submit
      width: 100%

  .diaries-grid
    display: flex
    flex-direction: column
    gap: 12px
  .diary-main,
  .diary-list
    display: flex
    flex-direction: column
    gap: 12px
  // 日記作成の主操作を日付ナビゲーションと同じ青系で統一
  .diary-create-actions
    display: flex
    flex-direction: column
    gap: 8px
    padding-top: 4px
    .diary-create-button
      display: inline-flex
      width: 100%
      min-height: 40px
      align-items: center
      justify-content: center
      gap: 7px
      border: 1px solid transparent
      border-radius: 6px
      font-weight: 600
      cursor: pointer
      transition: background-color 0.2s, border-color 0.2s, box-shadow 0.2s, color 0.2s
    .btn-main-diary
      color: #fff
      background-color: #2563eb
      border-color: #2563eb
      &:hover
        color: #fff
        background-color: #1d4ed8
        border-color: #1d4ed8
      &:focus
        box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.25)
    .btn-new-diary
      color: #2563eb
      background-color: #fff
      border-color: #bfdbfe
      &:hover
        color: #1d4ed8
        background-color: #eff6ff
        border-color: #93c5fd
      &:focus
        box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.18)
  .sectionHabitRecords
    flex: 0 0 auto
    max-width: $habit-records-width
  .sectionPinnedDiaries
    flex: 0 0 auto
    max-width: $pinned-diaries-width
  .sectionDiaries
    flex: 1 1 auto
    max-width: none
    min-width: 0
    overflow: auto
  .day-layout
    display: flex
    width: 100%
    align-items: flex-start
    justify-content: flex-start
    gap: 15px
  .day-section-header
    display: flex
    align-items: center
    justify-content: space-between
    h4
      flex-grow: 1
  .day-secondary-button,
  .day-count-button
    display: inline-flex
    align-items: center
    justify-content: center
    border: 1px solid #d6d3d1
    border-radius: 6px
    background: #fff
    color: #44403c
    cursor: pointer
    font-weight: 600
  .day-secondary-button
    width: 100%
    margin-bottom: 16px
    padding: 6px 12px
    font-size: 14px
    &:hover
      background: #f5f5f4
  .day-count-button
    min-width: 34px
    padding: 5px 10px
    border-color: #2563eb
    background: #2563eb
    color: #fff
    &:hover
      background: #1d4ed8

  @media (min-width: $desktop-breakpoint)
    .day-layout
      flex-wrap: nowrap
      align-items: flex-start
    .sectionHabitRecords
      width: $habit-records-width
    .sectionPinnedDiaries
      width: $pinned-diaries-width
    .sectionDiaries
      min-width: 0

  @media (max-width: $desktop-breakpoint - 1px)
    .day-layout
      flex-direction: column
    .sectionHabitRecords,
    .sectionDiaries,
    .sectionPinnedDiaries
      width: 100%
      max-width: none

  // PCではメイン日記を左、他の日記を右に並べる
  @media (min-width: $diary-two-columns-breakpoint)
    .diaries-grid.two-columns
      display: grid
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr)
      gap: 16px
      align-items: start
