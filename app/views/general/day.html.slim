- content_for :addjs_in_head
  = javascript_include_tag 'day_page', 'data-turbolinks-track': 'reload', defer: true
  = javascript_include_tag 'diaries_sidebar', 'data-turbolinks-track': 'reload', defer: true
#dayPage(v-cloak data-target-date="#{@date}")
  toast(:showable="toastShowable" :is-error="toastError" :message="toastMessage" @toast-hidden="toastShowable = false")
  / モーダルで日記を表示するためのhtmlの仕込み
  modal(v-if="!!modalableDiaryId" :no-padding="true" @on-close="closeDiaryModal")
    template(v-slot:content)
      diary(
        :diary-id="modalableDiaryId"
                  :can-append-memo="true"
        :modal-mode="true"
        ref="modalDiary"
        @submitted="reflectPinnedDiaries"
        @append-memo="showMemoForm"
      )

  / 「日記にメモ」フォーム
  - append_memo_form = capture do
    #memo-form.memo-modal(v-if="memoFormOpen" :class="{ 'is-over-history': memoOverHistoryModal }" role="dialog" aria-modal="true" :aria-label="memoModalTitle" @keydown.esc="closeMemoForm")
      .memo-modal__backdrop(@click="closeMemoForm")
      form.memo-modal__dialog(ref="memoForm" @submit="submitAppendingMemo")
        header.memo-modal__header
          h5
            | 📝
            | {{ memoModalTitle }}
          button.memo-modal__close(type="button" aria-label="閉じる" @click="closeMemoForm") ×
        .memo-modal__body
          .memo-modal__fields
            .memo-modal__field
              span.memo-modal__field-label
                clock-icon(:size="17" aria-hidden="true")
                | 時刻
              .memo-time-picker
                input(type="hidden" name="diary[time_memo]" :value="memoTime")
                button.memo-time-picker__toggle(type="button" @click="memoTimePickerOpen = !memoTimePickerOpen" :aria-expanded="memoTimePickerOpen.toString()")
                  clock-icon(:size="18" aria-hidden="true")
                  span
                    | {{ memoTime || '時間を選択' }}
                .memo-time-picker__panel(v-if="memoTimePickerOpen" @click.stop)
                  .memo-time-picker__heading
                    strong
                      | {{ memoTime || '--:--' }}
                    button(type="button" @click="setMemoTimeNow") 現在時刻
                  span.memo-time-picker__caption 時
                  .memo-time-picker__grid.memo-time-picker__grid--hours
                    button(type="button" v-for="hour in memoTimeHours" :key="hour" :class="{ active: memoTimeHour === hour }" @click="setMemoTimeHour(hour)") {{ hour }}
                  span.memo-time-picker__caption 分
                  .memo-time-picker__grid.memo-time-picker__grid--minutes
                    button(type="button" v-for="minute in memoTimeMinutes" :key="minute" :class="{ active: memoTimeMinute === minute }" @click="setMemoTimeMinute(minute)") {{ minute }}
                  .memo-time-picker__footer
                    button(type="button" @click="clearMemoTime") クリア
                    button(type="button" @click="memoTimePickerOpen = false") 決定
            label.memo-modal__field
              span.memo-modal__field-label 分類
              select(name="diary[label_memo]" v-model="memoCategory")
                option(v-for="cate in memoCategories" :value="cate" v-text="cate")
          p.memo-modal__target(v-if="memoTargetDiaryLabel")
            sticky-note-icon.memo-inline-icon(:size="15" aria-hidden="true")
            | 追記先: {{ memoTargetDiaryLabel }}
          textarea.memo-modal__textarea.first-focus(name="diary[memo]" v-model="memoContent" ref="memoContentField" @input="saveMemoDraft")
          input(type="hidden" name="diary[record_at]" :value="memoTargetRecordAt || '#{@date}'")
          input(type="hidden" name="diary[diary_id]" :value="memoTargetDiaryId")
        footer.memo-modal__footer
          small
            circle-alert-icon.memo-inline-icon(:size="15" aria-hidden="true")
            | 選択した日記の本文末尾にメモを追加します
          button.memo-modal__submit(type="submit") メモ追加

  .dayContentHeader
    .nav-container
      = link_to day_path(@date - 1), class: 'nav-arrow prev-day', title: 'ショートカットキー: shift + <' do
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
          polyline points="15 18 9 12 15 6"
      day-date-picker(selected-date="#{@date}" display-date="#{dispdate(@date, true)}" day-path-template="#{day_path('__DATE__')}")
      = link_to day_path(@date + 1), class: 'nav-arrow next-day', title: 'ショートカットキー: shift + >' do
        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
          polyline points="9 18 15 12 9 6"

    = append_memo_form
    .action-buttons
      = link_to root_path, class: 'action-button btn-today' do
        span.button-icon
          | 🏠
        | 今日
      = link_to month_path(month: @date.to_fs(:ym)), class: 'action-button btn-calendar' do
        span.button-icon
          | 📅
        | 月間


  .day-layout
    .sectionHabitRecords
      .page-header
        h4
          | 本日の記録
      p(v-if="habit_records.length == 0") 習慣が登録されていません。
      .habit-records(v-else)
        habit-record(v-for="habit_record in visibleHabitRecords" :habit="habit_record.habit" :record="habit_record.record" target-date="#{@date}" :key="habit_record.habit.id")
        button.day-secondary-button(type="button" v-if="hiddenHabitRecordsCount > 0" @click="showAllHabitRecords = true")
          | もっと見る（未記録 {{ hiddenHabitRecordsCount }}件）
        button.day-secondary-button(type="button" v-else-if="showAllHabitRecords && collapsibleHabitRecordsCount > 0" @click="showAllHabitRecords = false")
          | 閉じる

    / NOTE: .overflow-autoを付加すると、子要素の幅が限界を超えた時に、画面全体ではなく、この要素に対してスクロールバーが表示される
    / 付加しないと、画面全体にスクロールバーが表示される
    .sectionDiaries
      .page-header.day-section-header
        h4
          | 本日の日記&nbsp;
          .day-diary-list-control(ref="diaryListControl" v-show="diariesWithOpsions.length > 1")
            button.day-count-button(type="button" :aria-expanded="diaryListOpen.toString()" aria-label="日記リストを表示" @click="diaryListOpen = !diaryListOpen") {{ diariesWithOpsions.length }}
            .day-diary-popover(v-if="diaryListOpen" v-html="diary_links_list")
      .diaries(ref="diariesBody")
        p(v-if="diariesLoading") 読み込み中...
        template(v-else)
          p(v-if="diariesWithOpsions.length == 0") 日記はありません。
          .diaries-grid(v-else :class="{ 'two-columns': secondaryDiaryObjs.length > 0 }")
            .diary-main(v-if="mainDiaryObj")
              .diary-wrapper
                diary(
                  :diary="mainDiaryObj.diary"
                  :target-date-for-edit-mode="mainDiaryObj.targetDateForEditMode"
                  :highlight-for-a-moment="mainDiaryObj.highlightForAMoment"
                  :key="`diary-${mainDiaryObj.diary.id}`"
                  :categories="categories"
                  :collapsible-body="false"
                  :can-append-memo="true"
                  @content-changed="onContentChanged"
                  @submitted="onSubmitted"
                  @on-edit-mode="onEditMode"
                  @append-memo="showMemoForm"
                )
            .diary-list
              .diary-wrapper(v-for="obj in secondaryDiaryObjs")
                diary(
                  :diary="obj.diary"
                  :target-date-for-edit-mode="obj.targetDateForEditMode"
                  :highlight-for-a-moment="obj.highlightForAMoment"
                  :key="`diary-${obj.diary.id}`"
                  :categories="categories"
                  :collapsible-body="true"
                  :can-append-memo="true"
                  :collapse-by-default="shouldCollapseSecondaryDiary"
                  @content-changed="onContentChanged"
                  @submitted="onSubmitted"
                  @on-edit-mode="onEditMode"
                  @append-memo="showMemoForm"
                )
      .diary-create-actions(v-if="!diariesLoading")
        button.diary-create-button.btn-main-diary(type="button" v-if="!hasMainDiary" @click="newMainDiary")
          star-icon(:size="17" aria-hidden="true")
          | メイン日記を作成
        button.diary-create-button.btn-new-diary.ignore-checking-changes(type="button" @click="newDiary")
          pencil-icon(:size="17" aria-hidden="true")
          | 日記を書く


    .sectionPinnedDiaries
      / NOTE: turbolinks permanentで日付遷移時もDOMを保持し、サイドバーの再fetchを防ぐ
      #diariesSidebar[data-turbolinks-permanent]
