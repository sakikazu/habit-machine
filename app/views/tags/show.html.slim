.tag-page
  .tag-page-actions
    = link_to '戻る', tags_path, class: 'tag-button tag-button--neutral'
    = link_to '編集', edit_tag_path(@tag), class: 'tag-button tag-button--neutral'
  .page-header
    h3.tag-title
      | タグ:
      = content_tag('span', @tag.name, class: 'tag-color-preview', style: @tag.color_style)
      small.tag-diary-count = "日記数：#{@diaries.total_count}"
  p.description = sani_br(@tag.description)
  .tag-related-card
    .tag-related-card__header 関連日記
    = paginate @diaries, window: 3, outer_window: 2
    ul.tag-related-list
      - @diaries.each do |diary|
        li
          = link_to lucide_icon('calendar', size: 16, text: dispdate(diary.record_at, true)), day_path(diary.record_at)
          span.tag-related-title = link_to diary.title_mod, diary_with_date_path(diary.record_at, diary)
    = paginate @diaries, window: 3, outer_window: 2
