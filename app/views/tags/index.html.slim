.tag-page.tag-page--wide
  .page-header
    h2 タグ一覧
  .tag-table-container
    table.tag-table
      tr
        th タグ名
        th 文字色、背景色
        th ピン留め
        th 説明
        th 日記での使用数
        th
      - @tags.each do |tag|
        tr
          td = tag.name
          td = content_tag('span', tag.color, class: 'tag-color-preview', style: tag.color_style)
          td.tag-table__center = lucide_icon('pin', size: 16) if tag.pinned?
          td = truncate_30_link(tag.description)
          td = tag.taggings_count
          td
            = link_to '詳細', tag_path(tag)
            |  / 
            = link_to '編集', edit_tag_path(tag)
            |  / 
            = link_to '削除', tag_path(tag), method: :delete, data: { confirm: '本当に削除してもよろしいですか?' }
  .tag-page-actions
    = link_to '新しいタグを作成', new_tag_path, class: 'tag-button tag-button--neutral'
