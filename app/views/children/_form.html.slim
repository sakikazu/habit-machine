= form_with(model: @child, class: 'form') do |f|
  - if @child.errors.any?
    .child-form-errors
      ul
        - @child.errors.full_messages.each do |msg|
          li = msg

  .child-form-field
    = f.label :name, "名前"
    = f.text_field :name

  .child-form-field
    = f.label :birthday, "誕生日"
    = f.date_field :birthday

  .child-form-field
    = f.label :gender, "性別"
    = f.select :gender, Child::GENDER, include_blank: true

  = f.submit '登録する', class: 'child-button child-button--primary'
