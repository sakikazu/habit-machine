.row.pt-1.pb-1
  - home_path = year_child_child_histories_path(child, Time.now.year)
  - if child.profile_image.present?
    = link_to image_tag(child.profile_image, class: 'rounded-circle', width: '65px', height: '65px'), home_path
  .flex-grow-1.align-self-center
    h3.ml-2
      = link_to child.name, home_path, class: 'text-dark'
  .align-self-center
    = yield :child_header_actions
