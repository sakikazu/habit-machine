.category-management-page.category-management-page--narrow
  .category-page-actions
    = link_to '一覧へ', manage_categories_path, class: 'category-button category-button--neutral'
  .page-header
    h2 編集する
  = render 'form'
  .category-delete-area
    = link_to '削除する', category_path(@category), method: :delete, data: { confirm: '本当に削除してもよろしいですか?' }, class: 'category-button category-button--danger'
