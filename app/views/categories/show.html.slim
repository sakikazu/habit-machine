.category-management-page.category-management-page--narrow
  .category-page-actions
    = link_to '一覧へ', manage_categories_path, class: 'category-button category-button--neutral'
  .category-page-header
    h2 カテゴリ
    .category-page-actions
      = link_to '編集する', edit_category_path(@category), class: 'category-button category-button--neutral'
      = link_to '子カテゴリを登録', new_category_path(parent_id: @category.id), class: 'category-button category-button--primary'
  dl.category-detail
    dt カテゴリ名
    dd = @category.name

