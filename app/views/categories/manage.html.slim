.category-management-page
  ul.category-guide
    li 日記のカテゴリを管理します
    li カテゴリは3層まで階層化ができます
    li 家族で共有できるカテゴリは、「共有カテゴリを登録」から作成できます。その配下のカテゴリはすべて共有されます
  .category-page-header
    h2 カテゴリ一覧
    .category-page-actions
      = link_to 'カテゴリを登録', new_category_path, class: 'category-button category-button--primary'
      = link_to '共有カテゴリを登録', new_category_path(shared: 1), class: 'category-button category-button--shared'
  ul.category-tree
    - @categories.each do |category|
      li
        = link_to category_path(category) do
          = category.name
          - if category.shared?
            span.category-shared-label 家族共有
        ul
          - category.children.each do |child|
            li
              = link_to category_path(child) do
                = child.name
                - if child.shared?
                  span.category-shared-label 家族共有
              ul
                - child.children.each do |grandchild|
                  li
                    = link_to category_path(grandchild) do
                      = grandchild.name
                      - if grandchild.shared?
                        span.category-shared-label 家族共有
