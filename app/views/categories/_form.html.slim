- if @shared
  .category-notice
    | 共有カテゴリを登録します
- if @category.parent.present?
  .category-notice
    | 親カテゴリ：
    = @category.parent.name
- else
  .category-notice
    | トップのカテゴリです

= form_with(model: @category, local: true, class: 'form') do |f|
  - if @category.errors.any?
    .category-errors
      ul
        - @category.errors.full_messages.each do |msg|
          li = msg

  .category-field
    = f.label :name, 'カテゴリ名'
    = f.text_field :name

  / 一旦、編集時に親は変更できないようにしている
  - if @category.new_record?
    = hidden_field_tag(:parent_id, @category.parent&.id)
  = hidden_field_tag(:shared, @shared ? 1 : '')

  = f.submit '登録する', class: 'category-button category-button--primary'
