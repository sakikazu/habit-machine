.auth-card
  .auth-card__header
    h2 ログイン
  .auth-card__body
    = form_with model: resource, as: resource_name, url: session_path(resource_name), local: true, class: 'auth-form' do |f|
      .auth-field
        = f.label :email, 'メールアドレス'
        = f.email_field :email, autofocus: true, autocomplete: 'email'
      .auth-field
        = f.label :password, 'パスワード'
        = f.password_field :password, autocomplete: 'current-password'
      - if devise_mapping.rememberable?
        label.auth-checkbox
          = f.check_box :remember_me
          span ログイン状態を保持する
      = f.submit 'ログイン', class: 'auth-submit auth-submit--success'
    = render "devise/shared/links"
