.auth-back-link
  = link_to '戻る', root_path

.auth-card
  .auth-card__header
    h2 ユーザー情報更新
  .auth-card__body
    = form_with model: resource, as: resource_name, url: registration_path(resource_name), method: :put, local: true, class: 'auth-form' do |f|
      = render 'devise/shared/error_messages', resource: resource
      .auth-field
        = f.label :family_id, '家族'
        = text_field_tag :family_name, resource.family&.name, disabled: true
      .auth-field
        = f.label :email, 'メールアドレス'
        = f.email_field :email, required: true, autofocus: true, autocomplete: 'email'
      .auth-field
        = f.label :password, 'パスワード'
        = f.password_field :password, autocomplete: 'new-password'
        small ※パスワードを変更しない場合は空にしてください
      .auth-field
        = f.label :password_confirmation, 'パスワード（確認用）'
        = f.password_field :password_confirmation, autocomplete: 'new-password'
      .auth-field
        = f.label :familyname, '名字'
        = f.text_field :familyname, required: true
      .auth-field
        = f.label :givenname, '名前'
        = f.text_field :givenname, required: true
      .auth-field
        = f.label :nickname, 'ニックネーム'
        = f.text_field :nickname
      .auth-field
        = f.label :current_password, '現在のパスワード'
        = f.password_field :current_password, required: true, autocomplete: 'current-password'
        small ※情報を変更するには現在のパスワードが必要です
      = f.submit '更新する', class: 'auth-submit'
