.auth-card
  .auth-card__header
    h2 パスワードを忘れた場合
  .auth-card__body
    = form_with model: resource, as: resource_name, url: password_path(resource_name), method: :post, local: true, class: 'auth-form' do |f|
      = render 'devise/shared/error_messages', resource: resource
      .auth-field
        = f.label :email, 'メールアドレス'
        = f.email_field :email, required: true, autofocus: true, autocomplete: 'email'
      = f.submit 'パスワードのリセットメールを送信する', class: 'auth-submit'
    = render "devise/shared/links"
