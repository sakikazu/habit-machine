.row.justify-content-center
  .col-lg-10.col-xl-9
    .habit-index-header
      div
        h2.mb-1 過去の習慣
        p.text-muted.mb-0 休止中または達成済みの習慣
      = link_to habits_path, class: 'btn btn-light' do
        = fa_icon 'arrow-left', text: '有効な習慣へ'

    = render 'habit_group', title: '無効', icon: 'pause-circle-o', habits: @disabled_habits, empty_message: '無効にした習慣はありません'
    = render 'habit_group', title: '完了', icon: 'check-circle-o', habits: @done_habits, empty_message: '完了した習慣はありません'

= render 'management_styles'
