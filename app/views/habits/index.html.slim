.habit-page
  .habit-index-header
    div
      h2 習慣一覧
      p.habit-index-description 現在取り組んでいる習慣
    .habit-index-actions
      = link_to archive_habits_path, class: 'habit-button habit-button--neutral' do
        = lucide_icon 'archive', size: 16, text: '過去の習慣'
        span.habit-action-count = @disabled_habits_count + @done_habits_count
      = link_to new_habit_path, class: 'habit-button habit-button--primary' do
        = lucide_icon 'plus', size: 16, text: '習慣を登録する'

  - if @personal_habits.empty? && @family_habits.empty?
    .habit-empty-state
      = lucide_icon 'circle-check', size: 42, class: 'habit-empty-icon'
      h4 有効な習慣はありません
      p 新しい習慣を登録すると、ここに表示されます
      = link_to '最初の習慣を登録する', new_habit_path, class: 'habit-button habit-button--primary'
  - else
      = link_to '最初の習慣を登録する', new_habit_path, class: 'habit-button habit-button--primary'
  - else
    = render 'habit_group', title: '個人の習慣', icon: 'user', habits: @personal_habits, empty_message: '個人の習慣はありません'
    = render 'habit_group', title: '家族の習慣', icon: 'users', habits: @family_habits, empty_message: '家族の習慣はありません'
