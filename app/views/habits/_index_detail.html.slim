.card.habit-card
  .card-header.habit-card-header
    = link_to habit_path(habit.id), class: 'habit-card-title' do
      = habit.title
    .habit-card-actions
      span.habit-owner-label(class="#{habit.for_family? ? 'is-family' : 'is-personal'}")
        = lucide_icon(habit.for_family? ? 'users' : 'user', size: 15)
        = habit.for_family? ? '家族用' : '個人用'
      = link_to edit_habit_path(habit), class: 'habit-edit-link', title: '習慣を編集' do
        = lucide_icon 'pencil', size: 15, text: '編集'
  .card-body
    - if habit.goal.present?
      .card-text
        = sani_custom_br(habit.goal)
    - if habit.memo.present?
      p.text-muted.mt20
        = lucide_icon 'sticky-note', size: 15, text: sani_custom_br(habit.memo)

