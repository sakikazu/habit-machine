doctype html
html[lang="ja"]
  head
    meta[charset="utf-8"]
    meta[http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1"]
    meta[name="viewport" content="width=device-width, initial-scale=1.0"]
    title
      = content_for?(:title) ? yield(:title) : "日々の記録"
    = csrf_meta_tags
    = stylesheet_link_tag "application", :media => "all"
    = stylesheet_link_tag 'tailwind', 'data-turbolinks-track': 'reload'
    = favicon_link_tag 'logo/favicon.ico', :rel => 'icon'
  body
    nav.auth-navigation
      a.auth-navigation__brand[href="/"]
        = inline_svg_tag('logo/white-diary.svg', width: '35px', style: 'margin: -5px 0')
    main.auth-container
      - if notice.present?
        p.auth-alert.auth-alert--info = notice
      - if alert.present?
        p.auth-alert.auth-alert--error = alert
      = yield
